<script is:inline define:vars={{ meta: slides, machineOf }}>
(() => {
  const deck = document.getElementById('deck');
  const wipe = document.getElementById('wipe');
  const rail = document.getElementById('rail');
  const help = document.getElementById('help');
  const bar = { n: document.getElementById('bar-n'), m: document.getElementById('bar-machine') };
  const slides = [...deck.querySelectorAll('.slide')];
  const last = slides.length - 1;
  const pad = (n) => String(n).padStart(2, '0');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  let i = -1, wipeTimers = [];

  /* Deck mode is opt-out: with no JS the page below stays a plain readable
     document, which is also the "read as one page" view. */
  const PAGE = 'page', DECK = 'deck';
  let view = (location.search.includes('view=page') || localStorage.getItem('rice-view') === PAGE)
    ? PAGE : DECK;

  for (let k = 0; k <= last; k++) {
    const b = document.createElement('button');
    b.type = 'button';
    b.setAttribute('aria-label', `Slide ${pad(k)}`);
    b.addEventListener('click', () => go(k));
    rail.append(b);
  }
  const ticks = [...rail.children];

  function paint(next, sx) {
    const cur = deck.dataset.palette;
    deck.style.setProperty('--sx', sx + '%');
    if (cur === next) return;
    if (reduce.matches || view === PAGE) { deck.dataset.palette = next; return; }

    /* the wipe: a band of the incoming palette grown out of the spine */
    wipeTimers.forEach(clearTimeout); wipeTimers = [];
    wipe.dataset.palette = next;
    delete wipe.dataset.run; delete wipe.dataset.fade;
    wipe.style.setProperty('--wipe-l', sx + '%');
    wipe.style.setProperty('--wipe-r', (100 - sx) + '%');
    void wipe.offsetWidth;
    wipe.dataset.run = '';
    wipe.style.setProperty('--wipe-l', '0%');
    wipe.style.setProperty('--wipe-r', '0%');
    wipeTimers.push(setTimeout(() => {
      deck.dataset.palette = next;
      wipe.dataset.fade = '';
    }, 300));
    wipeTimers.push(setTimeout(() => {
      delete wipe.dataset.run; delete wipe.dataset.fade;
    }, 760));
  }

  function go(k, push = true) {
    k = Math.max(0, Math.min(last, k));
    if (k === i) return;
    i = k;
    const m = meta[k];
    slides.forEach((s, n) => n === k ? s.setAttribute('data-active', '') : s.removeAttribute('data-active'));
    ticks.forEach((t, n) => t.setAttribute('aria-current', n === k ? 'true' : 'false'));
    bar.n.textContent = pad(k);
    bar.m.textContent = machineOf[m.palette];
    paint(m.palette, m.split);
    if (push && location.hash !== '#' + k) history.pushState({ k }, '', '#' + k);
    if (view === DECK) slides[k].querySelector('.pane')?.scrollTo(0, 0);
  }

  function setView(v, remember = true) {
    view = v;
    if (remember) localStorage.setItem('rice-view', v);
    const on = v === DECK;
    deck.setAttribute('data-view', on ? DECK : PAGE);
    document.getElementById('toggle-view').textContent = on ? 'read as one page' : 'back to the deck';
    document.getElementById('toggle-view').setAttribute('aria-pressed', String(!on));
    document.documentElement.style.overflow = on ? 'hidden' : '';
    if (on) { const k = i < 0 ? fromHash() : i; i = -1; go(k, false); }
    else {
      slides.forEach((s) => s.removeAttribute('data-active'));
      deck.dataset.palette = 'site';
      deck.style.removeProperty('--sx');
      /* only jump to a slide when leaving the deck mid-way; a fresh load in
         page view starts at the masthead like any other document */
      if (i > 0) document.getElementById('s' + i)?.scrollIntoView();
    }
  }

  const fromHash = () => {
    const n = parseInt(location.hash.slice(1), 10);
    return Number.isInteger(n) && n >= 0 && n <= last ? n : 0;
  };

  setView(view, false);

  addEventListener('popstate', () => { if (view === DECK) go(fromHash(), false); });

  document.getElementById('toggle-view').addEventListener('click', () => setView(view === DECK ? PAGE : DECK));
  document.getElementById('help-btn').addEventListener('click', () => toggleHelp(true));
  help.addEventListener('click', () => toggleHelp(false));
  function toggleHelp(on) {
    help.hidden = !on;
    if (on) help.querySelector('.help__panel').focus?.();
  }

  addEventListener('keydown', (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (e.key === '?' || (e.key === '/' && e.shiftKey)) { e.preventDefault(); toggleHelp(help.hidden); return; }
    if (e.key === 'Escape') { if (!help.hidden) { toggleHelp(false); return; } location.href = '/#work'; return; }
    if (view !== DECK) return;
    const t = e.target;
    if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA')) return;
    switch (e.key) {
      case 'ArrowRight': case 'PageDown': e.preventDefault(); go(i + 1); break;
      case ' ': e.preventDefault(); go(i + 1); break;
      case 'ArrowLeft': case 'PageUp': e.preventDefault(); go(i - 1); break;
      case 'Home': e.preventDefault(); go(0); break;
      case 'End': e.preventDefault(); go(last); break;
    }
  });

  /* horizontal swipe only — vertical scroll inside a pane is never trapped */
  let sx = 0, sy = 0, tracking = false;
  deck.addEventListener('touchstart', (e) => {
    if (view !== DECK || e.touches.length !== 1) return;
    sx = e.touches[0].clientX; sy = e.touches[0].clientY; tracking = true;
  }, { passive: true });
  deck.addEventListener('touchend', (e) => {
    if (!tracking) return; tracking = false;
    const dx = e.changedTouches[0].clientX - sx, dy = e.changedTouches[0].clientY - sy;
    if (Math.abs(dx) > 56 && Math.abs(dx) > Math.abs(dy) * 1.6) go(dx < 0 ? i + 1 : i - 1);
  }, { passive: true });
})();
</script>
