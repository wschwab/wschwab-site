---
/* Alternate /rice/ world: oscilloscope bench.
 *
 * GATED. getStaticPaths emits this page only when `published` is true for
 * 'scope' in src/data/rice-worlds.ts; otherwise it returns no paths and the
 * URL genuinely 404s. That matters here because a publish is pinned to IPFS
 * and cannot be taken back, so "not ready" must mean "not routable".
 *
 * TO PUBLISH: set published: true for 'scope' in src/data/rice-worlds.ts and
 * run `npm run build`. That is the entire change — this file needs no edit.
 *
 * The riso world is the flagship and lives at /rice/ itself.
 */
import '../../../styles/world-scope.css';
import Deck from '../../../layouts/Deck.astro';
import RiceDeck from '../../../components/RiceDeck.astro';
import { isPublished } from '../../../data/rice-worlds';

export function getStaticPaths() {
  return isPublished('scope') ? [{ params: { gate: undefined } }] : [];
}

const contract = `IMPECCABLE DIRECTION CONTRACT — /rice/scope/ · direction seed 3856f232 challenger · mode: experience

THESIS: The deck as an instrument bench. Slides are channels measured against one
etched graticule; the guard is an armed trigger.

OWN-WORLD: Near-black glass #0A0E0C, phosphor #3BF04A, graticule #2B3C29, amber
#FFB000 reserved for armed and warning states exactly as on the bench. Fira
Condensed caps as bezel silkscreen, IBM 3270 for every readout, Iosevka behind
it. Ten-division graticule etched under everything, phosphor persistence on the
accent only, panels inset and etched rather than floating. Machine palettes
unchanged.

STORY: A visitor reads two machines as two signals on one instrument, and the
safety slides land in the bench's own vocabulary: armed, triggered, disarmed.

FIRST VIEWPORT: Even 50/50 across the graticule centreline. Condensed caps
headline, channel readout in 3270, trace sweeping in from the trigger point once.

FORM: split spine (surface seed 24fb6c50) inside the oscilloscope challenger,
built alongside the assigned direction at the user's request. Known weakness:
phosphor-green-on-black is the terminal-CRT rut the deck set out to refuse.

FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md`;
---
<Deck
  title="Two machines — scope"
  description="Oscilloscope-bench world for the /rice/ deck. Two desktop rices read as two signals on one instrument."
  contract={contract}
>
  <RiceDeck />
</Deck>
