---
import { getCollection } from 'astro:content';
import Record from '../../layouts/Record.astro';
import Page from '../../components/record/Page.astro';
import { exhibitOrder } from '../../lib/record';

const work = exhibitOrder(await getCollection('work', (e) => !e.data.draft));
---
<Record title="Exhibits" description="Selected work by William Schwab — smart contracts, engineering leadership, and Ethereum ecosystem projects.">
  <div class="record-caption">
    <h1 class="record-title">Index of Exhibits</h1>
    <p class="insertion" style="margin-top:.75rem">({work.length} exhibits entered. Each opens its full record; exhibits marked as external are held elsewhere.)</p>
  </div>
  <Page id="index" title="Exhibits" folio="i">
    <div class="ledger">
      <table>
        <caption class="sr">Index of exhibits</caption>
        <thead><tr><th scope="col">No.</th><th scope="col">Exhibit</th><th scope="col">Role, period</th></tr></thead>
        <tbody>
          {work.map((e, i) => (
            <tr>
              <td>{i + 1}</td>
              <td class="t">
                <a href={e.data.internal ?? e.data.external ?? `/work/${e.id}/`}>{e.data.title}</a>
                <p>{e.data.summary}</p>
              </td>
              <td class="d">{e.data.role}<small>{e.data.period}{e.data.external && ' · external'}{e.data.internal && ' · on this site'}</small></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </Page>
</Record>
