---
import { getCollection } from 'astro:content';
import Record from '../../layouts/Record.astro';
import Page from '../../components/record/Page.astro';
import Ln from '../../components/record/Ln.astro';
import { addressedBlocks, exhibitOrder, PARENS } from '../../lib/record';

export async function getStaticPaths() {
  const work = exhibitOrder(await getCollection('work', (e) => !e.data.draft));
  return work.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, no: i + 1, prev: work[i - 1], next: work[i + 1] },
  }));
}

const { entry, no, prev, next } = Astro.props;
const lines = addressedBlocks(entry.rendered?.html ?? '');
const heldAt = entry.data.internal ?? entry.data.external;
const heldLabel = entry.data.cta.replace(/\s*→$/, '');
---
<Record title={entry.data.title} description={entry.data.summary}>
  <div class="record-caption">
    <div class="exhibit-mark"><div class="sticker" aria-hidden="true"><span>Exhibit</span><b>{no}</b></div></div>
    <h1 class="record-title"><span class="sr">Exhibit {no}: </span>{entry.data.title}</h1>
    <div class="caption-grid">
      <p class="party">{entry.data.role},<br> {entry.data.period}.</p>
      <div class="paren" aria-hidden="true"><span>{PARENS}</span></div>
      <p class="matter">{entry.data.tags.join(', ')}.{entry.data.soft_tags.length > 0 && <><br> <span class="insertion">({entry.data.soft_tags.join(', ')})</span></>}</p>
    </div>
  </div>

  <Page id="record-body" title="Record" folio={1} class="prose">
    {lines.map((l) => <Ln id={l.id} html={l.html} />)}
    {heldAt && (
      <Ln>
        <p class="insertion">(This exhibit is held {entry.data.internal ? 'elsewhere on this site' : 'off-site'}:
          <a href={heldAt}>{heldLabel}</a>.)</p>
      </Ln>
    )}
  </Page>

  {entry.data.links.length > 0 && (
    <Page id="attachments" title="Attachments" folio={2}>
      {entry.data.links.map((l) => (
        <Ln><p><a href={l.url}>{l.label}</a></p></Ln>
      ))}
    </Page>
  )}

  <nav class="more" aria-label="Adjacent exhibits">
    <p>
      {prev && <a href={`/work/${prev.id}/`}>← Exhibit {no - 1}: {prev.data.title}</a>}
      {prev && next && <span class="insertion"> · </span>}
      {next && <a href={`/work/${next.id}/`}>Exhibit {no + 1}: {next.data.title} →</a>}
      <br><a href="/work/">Index of exhibits</a>
    </p>
  </nav>
</Record>
