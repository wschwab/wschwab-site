---
import { getCollection } from 'astro:content';
import Record from '../../../layouts/Record.astro';
import Page from '../../../components/record/Page.astro';
import { at } from '../../../lib/record';

const all = await getCollection('writing', (e) => !e.data.draft);
const byDate = (a: typeof all[number], b: typeof all[number]) =>
  (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0);
const sections = [
  { id: 'main', title: 'Writings', entries: all.filter((e) => e.data.archive_section === 'main').sort(byDate) },
  { id: 'older', title: 'Older & assorted', entries: all.filter((e) => e.data.archive_section === 'older').sort(byDate) },
].filter((s) => s.entries.length > 0);
const fmt = (d?: Date) =>
  d ? d.toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' }) : 'undated';
---
<Record title="Writing" description="Essays and technical writing by William Schwab — on Substack, Mirror, and Medium.">
  <div class="record-caption">
    <h1 class="record-title">Writings Entered</h1>
    <p class="insertion" style="margin-top:.75rem">(Essays held on Substack, Paragraph, Mirror, and Medium. The newest Substack post is entered on the <a href={at('/#writings')}>front of the record</a>.)</p>
  </div>
  {sections.map((s, n) => (
    <Page id={s.id} title={s.title} folio={n + 1}>
      <div class="ledger">
        <table>
          <caption class="sr">{s.title}</caption>
          <thead><tr><th scope="col">No.</th><th scope="col">Title</th><th scope="col">Held at</th></tr></thead>
          <tbody>
            {s.entries.map((e, i) => (
              <tr>
                <td>{i + 1}</td>
                <td class="t"><a href={e.data.url}>{e.data.title}</a><p>{e.data.summary}</p></td>
                <td class="d">{e.data.kind}<small>{fmt(e.data.date)}</small></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Page>
  ))}
</Record>
